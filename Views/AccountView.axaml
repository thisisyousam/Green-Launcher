<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GreenLauncher.Views.AccountView"
             x:CompileBindings="True">
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="16" Padding="24" MaxWidth="480"
            HorizontalAlignment="Left" BoxShadow="{DynamicResource CardShadow}">
        <StackPanel Spacing="20">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <Border Width="56" Height="56" CornerRadius="14" ClipToBounds="True" Background="{DynamicResource AccentTintBrush}">
                    <Grid>
                        <Path x:Name="AvatarPlaceholder" Width="24" Height="24" Stretch="Uniform"
                              Data="M12,4 A4,4 0 1 0 12,12 A4,4 0 1 0 12,4 Z M4,20 A8,7 0 0 1 20,20"
                              Stroke="{DynamicResource AccentTextOnTintBrush}" StrokeThickness="1.4" Fill="Transparent" />
                        <Image x:Name="AvatarImage" Stretch="UniformToFill" IsVisible="False"
                               RenderOptions.BitmapInterpolationMode="None" />
                    </Grid>
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="4">
                    <TextBlock x:Name="NicknameText" Text="" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock x:Name="UuidText" Text="" FontSize="12.5" FontFamily="{StaticResource MonoFont}"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <Border Height="1" Background="{DynamicResource BorderBrush2}" />

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="연결된 계정" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Microsoft 계정으로 로그인됨" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource AccentTintBrush}" CornerRadius="999" Padding="10,4"
                        VerticalAlignment="Center">
                    <TextBlock Text="연결됨" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextOnTintBrush}" />
                </Border>
            </Grid>

            <!-- 디자인 목업은 로그아웃 텍스트를 빨강(#c0392b)으로 표시하지만, design.md 규칙상
                 라임 외 강조색을 쓰지 않으므로 무채색 아웃라인 버튼으로 유지합니다. -->
            <Button x:Name="LogoutButton" Content="로그아웃" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Background="Transparent" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                    Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" Padding="0,11"
                    CornerRadius="999" Click="OnLogoutClick" />
        </StackPanel>
    </Border>
</UserControl>
